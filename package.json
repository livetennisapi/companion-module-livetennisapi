{
	"name": "livetennisapi",
	"version": "0.1.0",
	"description": "Bitfocus Companion connection for the Live Tennis API: live tennis scores as variables, feedbacks and actions",
	"main": "src/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"test": "node --test \"test/**/*.test.js\"",
		"check": "companion-module-check",
		"package": "companion-module-build"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/livetennisapi/companion-module-livetennisapi.git"
	},
	"bugs": {
		"url": "https://github.com/livetennisapi/companion-module-livetennisapi/issues"
	},
	"homepage": "https://livetennisapi.com",
	"author": {
		"name": "Synapse Research Ltd",
		"email": "hello@livetennisapi.com",
		"url": "https://synapsereality.io"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.2.2"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"eslint": "^10.14.0",
		"prettier": "^3.9.10"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.0",
	"resolutions": {
		"minimatch": "^11.0.1"
	},
	"//": {
		"resolutions.minimatch": "GHSA-g3hv-75wg-m249 (minimatch < 11.0.1). eslint 10.14.0 and @eslint/config-array 0.23.5 pin minimatch ^10.2.x and have no release on 11 yet. Drop this resolution once yarn why minimatch shows only 11.x without it."
	}
}
